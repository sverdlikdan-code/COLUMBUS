{
  "name": "International Control Desk — Dark Slate",
  "dataColors": [
    "#f59e0b",
    "#60a5fa",
    "#34d399",
    "#f87171",
    "#a78bfa",
    "#fb923c",
    "#38bdf8",
    "#4ade80"
  ],
  "good": "#34d399",
  "neutral": "#60a5fa",
  "bad": "#f87171",
  "maximum": "#34d399",
  "center": "#f59e0b",
  "minimum": "#f87171",
  "null": "#475569",
  "background": "#0f172a",
  "foreground": "#f1f5f9",
  "tableAccent": "#f59e0b",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "color": "#f59e0b",
      "fontSize": 45
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "color": "#f1f5f9",
      "fontSize": 18
    },
    "header": {
      "fontFace": "Segoe UI",
      "color": "#94a3b8",
      "fontSize": 12
    },
    "label": {
      "fontFace": "Segoe UI",
      "color": "#94a3b8",
      "fontSize": 11
    },
    "largeTitle": {
      "fontFace": "Segoe UI Semibold",
      "color": "#f1f5f9",
      "fontSize": 28
    },
    "smallLabel": {
      "fontFace": "Segoe UI",
      "color": "#64748b",
      "fontSize": 10
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{
          "color": { "solid": { "color": "#0f172a" } },
          "transparency": 0
        }],
        "outspace": [{
          "color": { "solid": { "color": "#0a0f1e" } },
          "transparency": 0
        }]
      }
    },
    "card": {
      "*": {
        "labels": [{
          "color": { "solid": { "color": "#94a3b8" } },
          "fontSize": 11
        }],
        "dataLabel": [{
          "color": { "solid": { "color": "#f59e0b" } },
          "fontSize": 32,
          "fontFamily": "Segoe UI Semibold"
        }],
        "background": [{
          "color": { "solid": { "color": "#1e2540" } },
          "transparency": 0
        }],
        "border": [{
          "color": { "solid": { "color": "#334155" } },
          "show": true
        }]
      }
    },
    "slicer": {
      "*": {
        "general": [{
          "outlineColor": { "solid": { "color": "#334155" } }
        }],
        "header": [{
          "fontColor": { "solid": { "color": "#f59e0b" } },
          "background": { "solid": { "color": "#0f172a" } },
          "show": true
        }],
        "items": [{
          "fontColor": { "solid": { "color": "#f1f5f9" } },
          "background": { "solid": { "color": "#1e2540" } }
        }]
      }
    }
  }
}
