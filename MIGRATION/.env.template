# COLUMBUS — Environment Variables Template
# Fill in ALL values before deploying to VPS
# Get actual values from: d.sverdlik@dilerbmd.com
# Store this file as .env in /home/columbus/COLUMBUS/.env
# Set permissions: chmod 600 .env

# ── DATABASE (SQL Server) ──────────────────────────────────────────────────
DB_SERVER=
DB_PORT=1433
DB_NAME=
DB_USER=
DB_PASSWORD=

# ── AZURE / POWER BI ──────────────────────────────────────────────────────
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
POWERBI_DATASET_ID=
POWERBI_WORKSPACE_ID=
TOKEN=

# ── AZURE MAPS ────────────────────────────────────────────────────────────
AZURE_MAPS_KEY=

# ── GITHUB ────────────────────────────────────────────────────────────────
GITHUB_TOKEN=

# ── FORMULA ROAD AUTH ─────────────────────────────────────────────────────
# Manager login password (keep secret)
MANAGER_PASS=

# Admin log access key — used for GET /admin/logs?key=KEY and POST /admin/revoke?key=KEY
ADMIN_LOG_KEY=
